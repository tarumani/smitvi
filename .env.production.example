# Copy to .env.production on the GoDaddy VPS (never commit secrets)

NEXT_PUBLIC_APP_URL=https://smitvi.com
NEXT_PUBLIC_APP_NAME=Smitvi
NODE_ENV=production

# Strong password for the Postgres container (also used by docker-compose)
POSTGRES_PASSWORD=change-me-to-a-long-random-password

# Supabase Auth (login only — you already use this)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Filled automatically by docker-compose for the app service; keep for reference
# DATABASE_URL=postgresql://smitvi:PASSWORD@db:5432/smitvi?sslmode=disable

# Local disk storage on the VPS (no Supabase Storage required)
STORAGE_DRIVER=local

# OpenAI (required for Twin AI / voice)
OPENAI_API_KEY=sk-...

# Payments (optional at launch)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_PRO=
RAZORPAY_PLAN_BUSINESS=

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60

# Comma-separated emails auto-promoted to ADMIN on first privileged visit
PLATFORM_ADMIN_EMAILS=you@example.com
