// Smitvi schema — Sprint 1–4
// Auth identity lives in Supabase Auth (auth.users).
// Application tables reference that UUID and own product data.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  EXPERT
  MODERATOR
  ADMIN
  SUPER_ADMIN
}

enum Plan {
  FREE
  PRO
  BUSINESS
}

enum ProfileVisibility {
  PUBLIC
  PRIVATE
  UNLISTED
}

enum AuditAction {
  USER_SYNCED
  USER_SIGNED_IN
  USER_SIGNED_OUT
  PROFILE_CREATED
  PROFILE_UPDATED
  PROFILE_AVATAR_UPDATED
  PROFILE_COVER_UPDATED
  ROLE_CHANGED
  PLAN_CHANGED
  KNOWLEDGE_UPLOADED
  KNOWLEDGE_PROCESSED
  KNOWLEDGE_FAILED
  TWIN_CHAT_STARTED
  PROFILE_FOLLOWED
  PROFILE_UNFOLLOWED
  REVIEW_CREATED
  SHARE_LINK_CREATED
  SUBSCRIPTION_STARTED
  SUBSCRIPTION_UPDATED
  SUBSCRIPTION_CANCELED
  PAYMENT_SUCCEEDED
  PAYMENT_FAILED
  MARKETPLACE_LISTING_CREATED
  MARKETPLACE_ORDER_CREATED
  MARKETPLACE_ORDER_PAID
  ORGANIZATION_CREATED
  ORGANIZATION_UPDATED
  ORGANIZATION_MEMBER_INVITED
  ORGANIZATION_MEMBER_JOINED
  ORGANIZATION_MEMBER_REMOVED
  ORGANIZATION_MEMBER_ROLE_CHANGED
  API_KEY_CREATED
  API_KEY_REVOKED
  VOICE_TWIN_USED
  CONSULTATION_OFFER_UPDATED
  CONSULTATION_REQUESTED
  CONSULTATION_REQUEST_UPDATED
  PROFILE_ONBOARDING_STARTED
  PROFILE_TYPE_SELECTED
  PROFILE_AI_ANALYSIS_REQUESTED
  PROFILE_AI_ANALYSIS_COMPLETED
  PROFILE_AI_SUGGESTION_ACCEPTED
  PROFILE_AI_SUGGESTION_REJECTED
  PROFILE_PROJECT_GENERATED
  PROFILE_ACTIVATED
  PROFILE_INTELLIGENCE_READY
  PROFILE_DISCOVERABILITY_ENABLED
  PROFILE_IMPROVE_WITH_AI_STARTED
  PROFILE_IMPROVE_WITH_AI_COMPLETED
  INTELLIGENCE_UPDATE_CONFIRMED
  INTELLIGENCE_ACTION_COMPLETED
  INTELLIGENCE_WEEKLY_REPORT
}

enum ProfileType {
  PROFESSIONAL
  CREATOR
  FREELANCER
  EDUCATOR
  FOUNDER
  STUDENT
}

enum ProfileActivationStatus {
  REGISTERED
  ONBOARDING_STARTED
  PROFILE_DRAFTED
  PROFILE_REVIEWED
  PROFILE_ACTIVATED
  INTELLIGENCE_READY
  DISCOVERABLE
  MONETIZABLE
}

enum IntelligenceReadinessLevel {
  STARTING
  BUILDING
  GROWING
  INTELLIGENT
  INTELLIGENCE_READY
}

enum OrgRole {
  OWNER
  ADMIN
  MEMBER
}

enum OrgInviteStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum KnowledgeSourceType {
  PDF
  DOCX
  PPTX
  TXT
  MARKDOWN
  ZIP
  GITHUB
  YOUTUBE
  WEBSITE
  NOTION
  GOOGLE_DRIVE
  IMAGE
  VIDEO
  AUDIO
}

enum KnowledgeProcessingStatus {
  PENDING
  EXTRACTING
  CHUNKING
  EMBEDDING
  SUMMARIZING
  READY
  FAILED
}

enum ConversationVisibility {
  PRIVATE
  PUBLIC
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum ShareLinkType {
  PROFILE
  TWIN_CHAT
  KNOWLEDGE
}

enum PaymentProvider {
  STRIPE
  RAZORPAY
  PAYPAL
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
  UNPAID
}

enum PaymentStatus {
  PENDING
  REQUIRES_ACTION
  SUCCEEDED
  FAILED
  REFUNDED
  CANCELED
}

enum MarketplaceListingType {
  CONSULTATION
  KNOWLEDGE_PACK
  EXPERT_SUBSCRIPTION
  SERVICE_PACKAGE
  TEMPLATE
  PROMPT_PACK
  GUIDE
  CHECKLIST
  CASE_STUDY
  COURSE
  VIDEO
  AUDIO
  BUNDLE
  PDF
}

enum ImportJobType {
  WEBSITE
  PDF
  LINKEDIN
  GITHUB
  YOUTUBE
  NOTION
}

enum ImportJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum MarketplaceListingStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum MarketplaceOrderStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELED
  FULFILLED
}

enum ConsultationRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELED
  COMPLETED
}

enum ListingVisibility {
  PUBLIC
  UNLISTED
  PRIVATE
}

enum CreatorWalletStatus {
  ACTIVE
  SUSPENDED
  ON_HOLD
}

enum CreatorPayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  ON_HOLD
}

enum CreatorPendingCreditStatus {
  PENDING
  SETTLED
  REVERSED
}

enum TwinAccessMode {
  FREE
  PAID
  SUBSCRIPTION
  PRIVATE
}

enum MarketplaceEventType {
  PRODUCT_VIEWED
  PRODUCT_PURCHASED
  AI_ACCESS_PURCHASED
  SUBSCRIPTION_STARTED
  SUBSCRIPTION_RENEWED
  SUBSCRIPTION_CANCELLED
  CONSULTATION_BOOKED
  PAYMENT_FAILED
  REFUND_CREATED
  PAYOUT_COMPLETED
}

enum MarketplaceRefundStatus {
  REQUESTED
  APPROVED
  REJECTED
  PROCESSING
  COMPLETED
  FAILED
  DISPUTED
}

enum MarketplaceRefundKind {
  FULL
  PARTIAL
  DISPUTE
}

model User {
  id                 String    @id @db.Uuid
  email              String    @unique
  emailVerified      Boolean   @default(false) @map("email_verified")
  role               Role      @default(USER)
  plan               Plan      @default(FREE)
  isActive           Boolean   @default(true) @map("is_active")
  isBanned           Boolean   @default(false) @map("is_banned")
  lastLoginAt        DateTime? @map("last_login_at")
  /** Set when the inactivity cleaner blocks an abandoned account. Cleared on login. */
  inactiveBlockedAt  DateTime? @map("inactive_blocked_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  deletedAt          DateTime? @map("deleted_at")

  profile              Profile?
  auditLogs            AuditLog[]
  knowledgeSources     KnowledgeSource[]
  conversations        Conversation[]
  chatUsageDays        ChatUsageDaily[]
  following            Follow[]              @relation("UserFollowing")
  followers            Follow[]              @relation("UserFollowers")
  reviewsWritten       Review[]              @relation("ReviewsWritten")
  reviewsReceived      Review[]              @relation("ReviewsReceived")
  shareLinks           ShareLink[]
  subscriptions        Subscription[]
  payments             Payment[]
  marketplaceListings  MarketplaceListing[]  @relation("SellerListings")
  marketplacePurchases MarketplaceOrder[]    @relation("BuyerOrders")
  marketplaceSales     MarketplaceOrder[]    @relation("SellerOrders")
  ownedOrganizations   Organization[]        @relation("OrganizationOwner")
  organizationMembers  OrganizationMember[]
  organizationInvitesSent OrganizationInvite[] @relation("OrgInvitesSent")
  apiKeys              ApiKey[]
  voiceSessions        VoiceSession[]
  consultationOffer    ConsultationOffer?
  consultationRequestsReceived ConsultationRequest[] @relation("ConsultationExpert")
  consultationRequestsSent     ConsultationRequest[] @relation("ConsultationRequester")
  importJobs                   ImportJob[]
  graphEntitiesOwned           GraphEntity[]         @relation("GraphEntityOwner")
  graphProcessingJobs          GraphProcessingJob[]
  recommendationEvents         RecommendationEvent[]
  recommendationFeedback       RecommendationFeedback[]
  twinQueryEvents              TwinQueryEvent[]
  twinFeedback                 TwinFeedback[]
  creatorWallet                CreatorWallet?
  creatorPayouts               CreatorPayout[]
  creatorPendingCredits        CreatorPendingCredit[]
  twinMonetizationSettings     TwinMonetizationSettings?
  twinCreatorSubscriptionsAsCreator TwinCreatorSubscription[] @relation("TwinCreator")
  twinCreatorSubscriptionsAsSubscriber TwinCreatorSubscription[] @relation("TwinSubscriber")
  marketplaceAccessGrants      MarketplaceAccess[]
  marketplaceReviews           MarketplaceReview[]
  marketplaceEvents            MarketplaceEvent[]
  pushDevices                  PushDevice[]
  twinInboxReads               TwinInboxRead[]
  socialActivityReads          SocialActivityRead[]
  dailyIntelligenceSnapshots   DailyIntelligenceSnapshot[]
  nextBestActions              NextBestAction[]
  userActionCompletions        UserActionCompletion[]
  weeklyIntelligenceReports    WeeklyIntelligenceReport[]
  meaningfulActivities         MeaningfulActivity[]

  @@index([role])
  @@index([plan])
  @@index([createdAt])
  @@index([deletedAt])
  @@index([lastLoginAt])
  @@index([inactiveBlockedAt])
  @@map("users")
}

model Profile {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String            @unique @map("user_id") @db.Uuid
  username         String            @unique
  displayName      String            @map("display_name")
  bio              String?           @db.VarChar(500)
  headline         String?           @db.VarChar(160)
  avatarUrl        String?           @map("avatar_url")
  coverUrl         String?           @map("cover_url")
  websiteUrl       String?           @map("website_url")
  location         String?           @db.VarChar(120)
  timezone         String?           @db.VarChar(64)
  visibility         ProfileVisibility @default(PUBLIC)
  isOnboarded        Boolean           @default(false) @map("is_onboarded")
  publicTwinEnabled  Boolean           @default(true) @map("public_twin_enabled")
  followersCount     Int               @default(0) @map("followers_count")
  followingCount     Int               @default(0) @map("following_count")
  ratingAverage      Float             @default(0) @map("rating_average")
  ratingCount        Int               @default(0) @map("rating_count")
  hubArchetypeId     String?           @map("hub_archetype_id") @db.VarChar(40)
  reputationScore    Float             @default(0) @map("reputation_score")
  onboardingStep     String?           @map("onboarding_step") @db.VarChar(32)
  profession           String?           @db.VarChar(80)
  interests            Json              @default("[]")
  intelligencePoints   Int               @default(0) @map("intelligence_points")
  hubDigestEmailEnabled Boolean        @default(true) @map("hub_digest_email_enabled")
  hubDigestLastSentAt   DateTime?      @map("hub_digest_last_sent_at")
  activationNudgeSentAt DateTime?      @map("activation_nudge_sent_at")
  listingNudgeSentAt    DateTime?      @map("listing_nudge_sent_at")
  referrerUsername      String?        @map("referrer_username") @db.VarChar(30)
  profileType                  ProfileType?               @map("profile_type")
  activationStatus             ProfileActivationStatus    @default(REGISTERED) @map("activation_status")
  intelligenceReadinessScore   Int                        @default(0) @map("intelligence_readiness_score")
  intelligenceReadinessLevel   IntelligenceReadinessLevel @default(STARTING) @map("intelligence_readiness_level")
  onboardingCompletedAt        DateTime?                  @map("onboarding_completed_at")
  profileActivatedAt           DateTime?                  @map("profile_activated_at")
  intelligenceReadyAt          DateTime?                  @map("intelligence_ready_at")
  discoverableAt               DateTime?                  @map("discoverable_at")
  monetizableAt                DateTime?                  @map("monetizable_at")
  profileAIAnalysisVersion     Int                        @default(0) @map("profile_ai_analysis_version")
  onboardingDraft              Json?                      @map("onboarding_draft")
  expertiseAreas               Json                       @default("[]") @map("expertise_areas")
  industries                   Json                       @default("[]")
  appearInExpertDiscovery      Boolean                    @default(false) @map("appear_in_expert_discovery")
  allowRecommendations         Boolean                    @default(true) @map("allow_recommendations")
  lastMeaningfulActivityAt     DateTime?                  @map("last_meaningful_activity_at")
  lastReengagementNotifiedAt   DateTime?                  @map("last_reengagement_notified_at")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills      ProfileSkill[]
  experiences Experience[]
  socialLinks SocialLink[]
  portfolio   PortfolioItem[]

  @@index([displayName])
  @@index([visibility])
  @@index([createdAt])
  @@index([ratingAverage])
  @@index([referrerUsername])
  @@index([activationStatus])
  @@index([profileType])
  @@index([intelligenceReadinessScore])
  @@map("profiles")
}

model Skill {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  profiles     ProfileSkill[]
  graphEntity  GraphEntity?

  @@map("skills")
}

model ProfileSkill {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId String   @map("profile_id") @db.Uuid
  skillId   String   @map("skill_id") @db.Uuid
  level     Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  skill   Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([profileId, skillId])
  @@index([skillId])
  @@map("profile_skills")
}

model Experience {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId   String    @map("profile_id") @db.Uuid
  title       String    @db.VarChar(160)
  company     String    @db.VarChar(160)
  description String?   @db.VarChar(2000)
  location    String?   @db.VarChar(120)
  startDate   DateTime  @map("start_date") @db.Date
  endDate     DateTime? @map("end_date") @db.Date
  isCurrent   Boolean   @default(false) @map("is_current")
  sortOrder   Int       @default(0) @map("sort_order")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, sortOrder])
  @@map("experiences")
}

model SocialLink {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId String   @map("profile_id") @db.Uuid
  platform  String   @db.VarChar(40)
  url       String
  createdAt DateTime @default(now()) @map("created_at")

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, platform])
  @@map("social_links")
}

model PortfolioItem {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId   String   @map("profile_id") @db.Uuid
  title       String   @db.VarChar(160)
  description String?  @db.VarChar(2000)
  url         String?
  imageUrl    String?  @map("image_url")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, sortOrder])
  @@map("portfolio_items")
}

model AuditLog {
  id         String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId    String?     @map("actor_id") @db.Uuid
  action     AuditAction
  entityType String      @map("entity_type") @db.VarChar(64)
  entityId   String?     @map("entity_id")
  metadata   Json?
  ipAddress  String?     @map("ip_address") @db.VarChar(64)
  userAgent  String?     @map("user_agent")
  createdAt  DateTime    @default(now()) @map("created_at")

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

/// Sprint 2 — Knowledge Twin corpus
model KnowledgeSource {
  id              String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String                    @map("user_id") @db.Uuid
  organizationId  String?                   @map("organization_id") @db.Uuid
  type            KnowledgeSourceType
  title           String                    @db.VarChar(240)
  originalName    String?                   @map("original_name") @db.VarChar(260)
  mimeType        String?                   @map("mime_type") @db.VarChar(120)
  byteSize        Int?                      @map("byte_size")
  storagePath     String?                   @map("storage_path")
  sourceUrl       String?                   @map("source_url")
  status          KnowledgeProcessingStatus @default(PENDING)
  errorMessage    String?                   @map("error_message")
  extractedText   String?                   @map("extracted_text") @db.Text
  summary         String?                   @db.Text
  faqs            Json?
  tags            String[]                  @default([])
  topics          String[]                  @default([])
  chunkCount      Int                       @default(0) @map("chunk_count")
  processingMs    Int?                      @map("processing_ms")
  isPublic        Boolean                   @default(false) @map("is_public")
  createdAt       DateTime                  @default(now()) @map("created_at")
  updatedAt       DateTime                  @updatedAt @map("updated_at")
  processedAt     DateTime?                 @map("processed_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  chunks            KnowledgeChunk[]
  graphEntitySources GraphEntitySource[]

  @@index([userId, createdAt])
  @@index([userId, status])
  @@index([organizationId, createdAt])
  @@index([organizationId, status])
  @@index([status])
  @@map("knowledge_sources")
}

model KnowledgeChunk {
  id         String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sourceId   String                       @map("source_id") @db.Uuid
  userId     String                       @map("user_id") @db.Uuid
  chunkIndex Int                          @map("chunk_index")
  content    String                       @db.Text
  tokenCount Int                          @default(0) @map("token_count")
  /// Stored via raw SQL as pgvector; Prisma keeps a float array mirror for portability.
  embedding  Float[]                      @default([])
  metadata   Json?
  createdAt  DateTime                     @default(now()) @map("created_at")

  source KnowledgeSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([sourceId, chunkIndex])
  @@index([userId])
  @@index([sourceId])
  @@map("knowledge_chunks")
}

model Conversation {
  id             String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String                 @map("user_id") @db.Uuid
  ownerUserId    String                 @map("owner_user_id") @db.Uuid
  organizationId String?                @map("organization_id") @db.Uuid
  title          String?                @db.VarChar(160)
  visibility     ConversationVisibility @default(PRIVATE)
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @updatedAt @map("updated_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  messages     ConversationMessage[]

  @@index([userId, updatedAt])
  @@index([ownerUserId, updatedAt])
  @@index([organizationId, updatedAt])
  @@map("conversations")
}

model ConversationMessage {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId String      @map("conversation_id") @db.Uuid
  role           MessageRole
  content        String      @db.Text
  confidence     Float?
  citations      Json?
  createdAt      DateTime    @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("conversation_messages")
}

model PushDevice {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  expoPushToken String   @map("expo_push_token") @db.VarChar(512)
  platform      String?  @db.VarChar(32)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, expoPushToken])
  @@index([userId])
  @@map("push_devices")
}

model TwinInboxRead {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  readAt         DateTime @default(now()) @map("read_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, conversationId])
  @@index([userId])
  @@map("twin_inbox_reads")
}

/// Per-user read markers for FOLLOW / REVIEW notification rows (mobile + API).
model SocialActivityRead {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  activityKey String  @map("activity_key") @db.VarChar(80)
  readAt     DateTime @default(now()) @map("read_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, activityKey])
  @@index([userId])
  @@map("social_activity_reads")
}

model ChatUsageDaily {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  usageDate    DateTime @map("usage_date") @db.Date
  messageCount Int      @default(0) @map("message_count")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, usageDate])
  @@index([usageDate])
  @@map("chat_usage_daily")
}

/// Sprint 3 — Social graph, reviews, share links
model Follow {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  followerId  String   @map("follower_id") @db.Uuid
  followingId String   @map("following_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  follower  User @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId, createdAt])
  @@index([followerId, createdAt])
  @@map("follows")
}

model Review {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reviewerId String   @map("reviewer_id") @db.Uuid
  revieweeId String   @map("reviewee_id") @db.Uuid
  rating     Int
  comment    String?  @db.VarChar(1000)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  reviewer User @relation("ReviewsWritten", fields: [reviewerId], references: [id], onDelete: Cascade)
  reviewee User @relation("ReviewsReceived", fields: [revieweeId], references: [id], onDelete: Cascade)

  @@unique([reviewerId, revieweeId])
  @@index([revieweeId, createdAt])
  @@map("reviews")
}

model ShareLink {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  token       String        @unique @db.VarChar(40)
  ownerUserId String        @map("owner_user_id") @db.Uuid
  type        ShareLinkType
  targetId    String?       @map("target_id")
  label       String?       @db.VarChar(160)
  isActive    Boolean       @default(true) @map("is_active")
  clickCount  Int           @default(0) @map("click_count")
  expiresAt   DateTime?     @map("expires_at")
  createdAt   DateTime      @default(now()) @map("created_at")

  owner User @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  @@index([ownerUserId, createdAt])
  @@index([type, targetId])
  @@map("share_links")
}

/// Sprint 4 — Billing & marketplace
model Subscription {
  id                   String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId               String             @map("user_id") @db.Uuid
  plan                 Plan
  provider             PaymentProvider
  status               SubscriptionStatus @default(INCOMPLETE)
  externalCustomerId   String?            @map("external_customer_id")
  externalSubscriptionId String?          @unique @map("external_subscription_id")
  externalPriceId      String?            @map("external_price_id")
