  DEPRECATED
  REMOVED
}

enum GraphVisibility {
  PUBLIC
  FOLLOWERS
  CONNECTIONS
  PRIVATE
}

enum GraphVerificationStatus {
  PENDING
  AI_DETECTED
  USER_VERIFIED
  USER_REJECTED
  HIDDEN
}

enum GraphRelationshipSource {
  USER
  AI
  PROFILE
  IMPORT
  ADMIN
}

enum GraphEvidenceSourceType {
  KNOWLEDGE_SOURCE
  KNOWLEDGE_CHUNK
  PROFILE_FIELD
