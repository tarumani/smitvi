// Smitvi schema — Sprint 1–4
// Auth identity lives in Supabase Auth (auth.users).
// Application tables reference that UUID and own product data.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  EXPERT
  MODERATOR
  ADMIN
  SUPER_ADMIN
}

enum Plan {
  FREE
  PRO
  BUSINESS
}

enum ProfileVisibility {
  PUBLIC
  PRIVATE
  UNLISTED
}

enum AuditAction {
  USER_SYNCED
  USER_SIGNED_IN
  USER_SIGNED_OUT
  PROFILE_CREATED
  PROFILE_UPDATED
  PROFILE_AVATAR_UPDATED
  PROFILE_COVER_UPDATED
  ROLE_CHANGED
  PLAN_CHANGED
  KNOWLEDGE_UPLOADED
  KNOWLEDGE_PROCESSED
  KNOWLEDGE_FAILED
  TWIN_CHAT_STARTED
  PROFILE_FOLLOWED
  PROFILE_UNFOLLOWED
  REVIEW_CREATED
  SHARE_LINK_CREATED
  SUBSCRIPTION_STARTED
  SUBSCRIPTION_UPDATED
  SUBSCRIPTION_CANCELED
  PAYMENT_SUCCEEDED
  PAYMENT_FAILED
  MARKETPLACE_LISTING_CREATED
  MARKETPLACE_ORDER_CREATED
  MARKETPLACE_ORDER_PAID
  ORGANIZATION_CREATED
  ORGANIZATION_UPDATED
  ORGANIZATION_MEMBER_INVITED
  ORGANIZATION_MEMBER_JOINED
  ORGANIZATION_MEMBER_REMOVED
  ORGANIZATION_MEMBER_ROLE_CHANGED
  API_KEY_CREATED
  API_KEY_REVOKED
  VOICE_TWIN_USED
  CONSULTATION_OFFER_UPDATED
  CONSULTATION_REQUESTED
  CONSULTATION_REQUEST_UPDATED
}

enum OrgRole {
  OWNER
  ADMIN
  MEMBER
}

enum OrgInviteStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum KnowledgeSourceType {
  PDF
  DOCX
  PPTX
  TXT
  MARKDOWN
  ZIP
  GITHUB
  YOUTUBE
  WEBSITE
  NOTION
  GOOGLE_DRIVE
  IMAGE
  VIDEO
  AUDIO
}

enum KnowledgeProcessingStatus {
  PENDING
  EXTRACTING
  CHUNKING
  EMBEDDING
  SUMMARIZING
  READY
  FAILED
}

enum ConversationVisibility {
  PRIVATE
  PUBLIC
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum ShareLinkType {
  PROFILE
  TWIN_CHAT
  KNOWLEDGE
}

enum PaymentProvider {
  STRIPE
  RAZORPAY
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
  UNPAID
}

enum PaymentStatus {
  PENDING
  REQUIRES_ACTION
  SUCCEEDED
  FAILED
  REFUNDED
  CANCELED
}

enum MarketplaceListingType {
  CONSULTATION
  KNOWLEDGE_PACK
  EXPERT_SUBSCRIPTION
  SERVICE_PACKAGE
  TEMPLATE
  PROMPT_PACK
}

enum ImportJobType {
  WEBSITE
  PDF
  LINKEDIN
  GITHUB
  YOUTUBE
}

enum ImportJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum MarketplaceListingStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum MarketplaceOrderStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELED
  FULFILLED
}

enum ConsultationRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELED
  COMPLETED
}

model User {
  id            String    @id @db.Uuid
  email         String    @unique
  emailVerified Boolean   @default(false) @map("email_verified")
  role          Role      @default(USER)
  plan          Plan      @default(FREE)
  isActive      Boolean   @default(true) @map("is_active")
  isBanned      Boolean   @default(false) @map("is_banned")
  lastLoginAt   DateTime? @map("last_login_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  profile              Profile?
  auditLogs            AuditLog[]
  knowledgeSources     KnowledgeSource[]
  conversations        Conversation[]
  chatUsageDays        ChatUsageDaily[]
  following            Follow[]              @relation("UserFollowing")
  followers            Follow[]              @relation("UserFollowers")
  reviewsWritten       Review[]              @relation("ReviewsWritten")
  reviewsReceived      Review[]              @relation("ReviewsReceived")
  shareLinks           ShareLink[]
  subscriptions        Subscription[]
  payments             Payment[]
  marketplaceListings  MarketplaceListing[]  @relation("SellerListings")
  marketplacePurchases MarketplaceOrder[]    @relation("BuyerOrders")
  marketplaceSales     MarketplaceOrder[]    @relation("SellerOrders")
  ownedOrganizations   Organization[]        @relation("OrganizationOwner")
  organizationMembers  OrganizationMember[]
  organizationInvitesSent OrganizationInvite[] @relation("OrgInvitesSent")
  apiKeys              ApiKey[]
  voiceSessions        VoiceSession[]
  consultationOffer    ConsultationOffer?
  consultationRequestsReceived ConsultationRequest[] @relation("ConsultationExpert")
  consultationRequestsSent     ConsultationRequest[] @relation("ConsultationRequester")
  importJobs                   ImportJob[]

  @@index([role])
  @@index([plan])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("users")
}

model Profile {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String            @unique @map("user_id") @db.Uuid
  username         String            @unique
  displayName      String            @map("display_name")
  bio              String?           @db.VarChar(500)
  headline         String?           @db.VarChar(160)
  avatarUrl        String?           @map("avatar_url")
  coverUrl         String?           @map("cover_url")
  websiteUrl       String?           @map("website_url")
  location         String?           @db.VarChar(120)
  timezone         String?           @db.VarChar(64)
  visibility         ProfileVisibility @default(PUBLIC)
  isOnboarded        Boolean           @default(false) @map("is_onboarded")
  publicTwinEnabled  Boolean           @default(true) @map("public_twin_enabled")
  followersCount     Int               @default(0) @map("followers_count")
  followingCount     Int               @default(0) @map("following_count")
  ratingAverage      Float             @default(0) @map("rating_average")
  ratingCount        Int               @default(0) @map("rating_count")
  hubArchetypeId     String?           @map("hub_archetype_id") @db.VarChar(40)
  reputationScore    Float             @default(0) @map("reputation_score")
  onboardingStep     String?           @map("onboarding_step") @db.VarChar(32)
  profession           String?           @db.VarChar(80)
  interests            Json              @default("[]")
  intelligencePoints   Int               @default(0) @map("intelligence_points")
  hubDigestEmailEnabled Boolean        @default(true) @map("hub_digest_email_enabled")
  hubDigestLastSentAt   DateTime?      @map("hub_digest_last_sent_at")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills      ProfileSkill[]
  experiences Experience[]
  socialLinks SocialLink[]
  portfolio   PortfolioItem[]

  @@index([displayName])
  @@index([visibility])
  @@index([createdAt])
  @@index([ratingAverage])
  @@map("profiles")
}

model Skill {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  profiles ProfileSkill[]

  @@map("skills")
}

model ProfileSkill {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId String   @map("profile_id") @db.Uuid
  skillId   String   @map("skill_id") @db.Uuid
  level     Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  skill   Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([profileId, skillId])
  @@index([skillId])
  @@map("profile_skills")
}

model Experience {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId   String    @map("profile_id") @db.Uuid
  title       String    @db.VarChar(160)
  company     String    @db.VarChar(160)
  description String?   @db.VarChar(2000)
  location    String?   @db.VarChar(120)
  startDate   DateTime  @map("start_date") @db.Date
  endDate     DateTime? @map("end_date") @db.Date
  isCurrent   Boolean   @default(false) @map("is_current")
  sortOrder   Int       @default(0) @map("sort_order")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, sortOrder])
  @@map("experiences")
}

model SocialLink {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId String   @map("profile_id") @db.Uuid
  platform  String   @db.VarChar(40)
  url       String
  createdAt DateTime @default(now()) @map("created_at")

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, platform])
  @@map("social_links")
}

model PortfolioItem {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId   String   @map("profile_id") @db.Uuid
  title       String   @db.VarChar(160)
  description String?  @db.VarChar(2000)
  url         String?
  imageUrl    String?  @map("image_url")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, sortOrder])
  @@map("portfolio_items")
}

model AuditLog {
  id         String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId    String?     @map("actor_id") @db.Uuid
  action     AuditAction
  entityType String      @map("entity_type") @db.VarChar(64)
  entityId   String?     @map("entity_id")
  metadata   Json?
  ipAddress  String?     @map("ip_address") @db.VarChar(64)
  userAgent  String?     @map("user_agent")
  createdAt  DateTime    @default(now()) @map("created_at")

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

/// Sprint 2 — Knowledge Twin corpus
model KnowledgeSource {
  id              String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String                    @map("user_id") @db.Uuid
  organizationId  String?                   @map("organization_id") @db.Uuid
  type            KnowledgeSourceType
  title           String                    @db.VarChar(240)
  originalName    String?                   @map("original_name") @db.VarChar(260)
  mimeType        String?                   @map("mime_type") @db.VarChar(120)
  byteSize        Int?                      @map("byte_size")
  storagePath     String?                   @map("storage_path")
  sourceUrl       String?                   @map("source_url")
  status          KnowledgeProcessingStatus @default(PENDING)
  errorMessage    String?                   @map("error_message")
  extractedText   String?                   @map("extracted_text") @db.Text
  summary         String?                   @db.Text
  faqs            Json?
  tags            String[]                  @default([])
  topics          String[]                  @default([])
  chunkCount      Int                       @default(0) @map("chunk_count")
  processingMs    Int?                      @map("processing_ms")
  isPublic        Boolean                   @default(false) @map("is_public")
  createdAt       DateTime                  @default(now()) @map("created_at")
  updatedAt       DateTime                  @updatedAt @map("updated_at")
  processedAt     DateTime?                 @map("processed_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  chunks       KnowledgeChunk[]

  @@index([userId, createdAt])
  @@index([userId, status])
  @@index([organizationId, createdAt])
  @@index([organizationId, status])
  @@index([status])
  @@map("knowledge_sources")
}

model KnowledgeChunk {
  id         String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sourceId   String                       @map("source_id") @db.Uuid
  userId     String                       @map("user_id") @db.Uuid
  chunkIndex Int                          @map("chunk_index")
  content    String                       @db.Text
  tokenCount Int                          @default(0) @map("token_count")
  /// Stored via raw SQL as pgvector; Prisma keeps a float array mirror for portability.
  embedding  Float[]                      @default([])
  metadata   Json?
  createdAt  DateTime                     @default(now()) @map("created_at")

  source KnowledgeSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([sourceId, chunkIndex])
  @@index([userId])
  @@index([sourceId])
  @@map("knowledge_chunks")
}

model Conversation {
  id             String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String                 @map("user_id") @db.Uuid
  ownerUserId    String                 @map("owner_user_id") @db.Uuid
  organizationId String?                @map("organization_id") @db.Uuid
  title          String?                @db.VarChar(160)
  visibility     ConversationVisibility @default(PRIVATE)
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @updatedAt @map("updated_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  messages     ConversationMessage[]

  @@index([userId, updatedAt])
  @@index([ownerUserId, updatedAt])
  @@index([organizationId, updatedAt])
  @@map("conversations")
}

model ConversationMessage {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId String      @map("conversation_id") @db.Uuid
  role           MessageRole
  content        String      @db.Text
  confidence     Float?
  citations      Json?
  createdAt      DateTime    @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("conversation_messages")
}

model ChatUsageDaily {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  usageDate    DateTime @map("usage_date") @db.Date
  messageCount Int      @default(0) @map("message_count")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, usageDate])
  @@index([usageDate])
  @@map("chat_usage_daily")
}

/// Sprint 3 — Social graph, reviews, share links
model Follow {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  followerId  String   @map("follower_id") @db.Uuid
  followingId String   @map("following_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  follower  User @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId, createdAt])
  @@index([followerId, createdAt])
  @@map("follows")
}

model Review {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reviewerId String   @map("reviewer_id") @db.Uuid
  revieweeId String   @map("reviewee_id") @db.Uuid
  rating     Int
  comment    String?  @db.VarChar(1000)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  reviewer User @relation("ReviewsWritten", fields: [reviewerId], references: [id], onDelete: Cascade)
  reviewee User @relation("ReviewsReceived", fields: [revieweeId], references: [id], onDelete: Cascade)

  @@unique([reviewerId, revieweeId])
  @@index([revieweeId, createdAt])
  @@map("reviews")
}

model ShareLink {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  token       String        @unique @db.VarChar(40)
  ownerUserId String        @map("owner_user_id") @db.Uuid
  type        ShareLinkType
  targetId    String?       @map("target_id")
  label       String?       @db.VarChar(160)
  isActive    Boolean       @default(true) @map("is_active")
  clickCount  Int           @default(0) @map("click_count")
  expiresAt   DateTime?     @map("expires_at")
  createdAt   DateTime      @default(now()) @map("created_at")

  owner User @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  @@index([ownerUserId, createdAt])
  @@index([type, targetId])
  @@map("share_links")
}

/// Sprint 4 — Billing & marketplace
model Subscription {
  id                   String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId               String             @map("user_id") @db.Uuid
  plan                 Plan
  provider             PaymentProvider
  status               SubscriptionStatus @default(INCOMPLETE)
  externalCustomerId   String?            @map("external_customer_id")
  externalSubscriptionId String?          @unique @map("external_subscription_id")
  externalPriceId      String?            @map("external_price_id")
  cancelAtPeriodEnd    Boolean            @default(false) @map("cancel_at_period_end")
  currentPeriodStart   DateTime?          @map("current_period_start")
  currentPeriodEnd     DateTime?          @map("current_period_end")
  canceledAt           DateTime?          @map("canceled_at")
  metadata             Json?
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@index([userId, status])
  @@index([provider, status])
  @@map("subscriptions")
}

model Payment {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String          @map("user_id") @db.Uuid
  subscriptionId    String?         @map("subscription_id") @db.Uuid
  marketplaceOrderId String?        @unique @map("marketplace_order_id") @db.Uuid
  provider          PaymentProvider
  status            PaymentStatus   @default(PENDING)
  currency          String          @db.VarChar(3)
  amountCents       Int             @map("amount_cents")
  purpose           String          @db.VarChar(64)
  externalPaymentId String?         @unique @map("external_payment_id")
  externalSessionId String?         @map("external_session_id")
  receiptUrl        String?         @map("receipt_url")
  failureReason     String?         @map("failure_reason")
  metadata          Json?
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription     Subscription?     @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  marketplaceOrder MarketplaceOrder? @relation(fields: [marketplaceOrderId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([provider, status])
  @@map("payments")
}

model MarketplaceListing {
  id              String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId        String                   @map("seller_id") @db.Uuid
  type            MarketplaceListingType
  status          MarketplaceListingStatus @default(DRAFT)
  title           String                   @db.VarChar(160)
  description     String                   @db.VarChar(2000)
  currency        String                   @default("USD") @db.VarChar(3)
  priceCents      Int                      @map("price_cents")
  durationMinutes Int?                     @map("duration_minutes")
  knowledgeSourceId String?                @map("knowledge_source_id") @db.Uuid
  isFeatured      Boolean                  @default(false) @map("is_featured")
  createdAt       DateTime                 @default(now()) @map("created_at")
  updatedAt       DateTime                 @updatedAt @map("updated_at")

  seller User               @relation("SellerListings", fields: [sellerId], references: [id], onDelete: Cascade)
  orders MarketplaceOrder[]

  @@index([sellerId, status])
  @@index([status, createdAt])
  @@index([type, status])
  @@map("marketplace_listings")
}

model MarketplaceOrder {
  id               String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  listingId        String                 @map("listing_id") @db.Uuid
  buyerId          String                 @map("buyer_id") @db.Uuid
  sellerId         String                 @map("seller_id") @db.Uuid
  status           MarketplaceOrderStatus @default(PENDING)
  currency         String                 @db.VarChar(3)
  grossAmountCents Int                    @map("gross_amount_cents")
  commissionRate   Float                  @map("commission_rate")
  commissionCents  Int                    @map("commission_cents")
  netAmountCents   Int                    @map("net_amount_cents")
  provider         PaymentProvider?
  paidAt           DateTime?              @map("paid_at")
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @updatedAt @map("updated_at")

  listing MarketplaceListing @relation(fields: [listingId], references: [id], onDelete: Restrict)
  buyer   User               @relation("BuyerOrders", fields: [buyerId], references: [id], onDelete: Cascade)
  seller  User               @relation("SellerOrders", fields: [sellerId], references: [id], onDelete: Cascade)
  payment Payment?

  @@index([buyerId, createdAt])
  @@index([sellerId, createdAt])
  @@index([status, createdAt])
  @@map("marketplace_orders")
}

/// Sprint 5 — Company workspaces
model Organization {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String    @db.VarChar(120)
  slug        String    @unique @db.VarChar(40)
  description String?   @db.VarChar(500)
  logoUrl     String?   @map("logo_url")
  ownerUserId String    @map("owner_user_id") @db.Uuid
  seatLimit   Int       @default(25) @map("seat_limit")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  owner            User                 @relation("OrganizationOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  members          OrganizationMember[]
  invites          OrganizationInvite[]
  knowledgeSources KnowledgeSource[]
  conversations    Conversation[]

  @@index([ownerUserId])
  @@index([createdAt])
  @@map("organizations")
}

model OrganizationMember {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  role           OrgRole  @default(MEMBER)
  joinedAt       DateTime @default(now()) @map("joined_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId, role])
  @@map("organization_members")
}

model OrganizationInvite {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  email          String          @db.VarChar(320)
  role           OrgRole         @default(MEMBER)
  token          String          @unique @db.VarChar(64)
  status         OrgInviteStatus @default(PENDING)
  invitedById    String          @map("invited_by_id") @db.Uuid
  expiresAt      DateTime        @map("expires_at")
  acceptedAt     DateTime?       @map("accepted_at")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation("OrgInvitesSent", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([email, status])
  @@map("organization_invites")
}

/// Sprint 6 — Public API keys + voice Twin sessions
model ApiKey {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  name       String    @db.VarChar(80)
  keyPrefix  String    @map("key_prefix") @db.VarChar(16)
  keyHash    String    @unique @map("key_hash") @db.VarChar(64)
  scopes     String[]  @default(["twin:ask", "knowledge:read"])
  lastUsedAt DateTime? @map("last_used_at")
  revokedAt  DateTime? @map("revoked_at")
  expiresAt  DateTime? @map("expires_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, revokedAt])
  @@map("api_keys")
}

model VoiceSession {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  conversationId String?  @map("conversation_id") @db.Uuid
  transcript     String   @db.Text
  answer         String   @db.Text
  confidence     Float?
  durationMs     Int?     @map("duration_ms")
  createdAt      DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("voice_sessions")
}

/// Sprint 4 — paid/consult booking foundation
model ConsultationOffer {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String   @unique @map("user_id") @db.Uuid
  enabled         Boolean  @default(false)
  headline        String?  @db.VarChar(160)
  description     String?  @db.VarChar(1000)
  durationMinutes Int      @default(30) @map("duration_minutes")
  priceCents      Int      @default(0) @map("price_cents")
  currency        String   @default("USD") @db.VarChar(3)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user     User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  requests ConsultationRequest[]

  @@index([enabled])
  @@map("consultation_offers")
}

model ConsultationRequest {
  id               String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  offerId          String                     @map("offer_id") @db.Uuid
  expertUserId     String                     @map("expert_user_id") @db.Uuid
  requesterUserId  String?                    @map("requester_user_id") @db.Uuid
  requesterName    String                     @map("requester_name") @db.VarChar(120)
  requesterEmail   String                     @map("requester_email") @db.VarChar(254)
  message          String?                    @db.VarChar(2000)
  preferredAt      DateTime?                  @map("preferred_at")
  status           ConsultationRequestStatus  @default(PENDING)
  createdAt        DateTime                   @default(now()) @map("created_at")
  updatedAt        DateTime                   @updatedAt @map("updated_at")

  offer     ConsultationOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  expert    User              @relation("ConsultationExpert", fields: [expertUserId], references: [id], onDelete: Cascade)
  requester User?             @relation("ConsultationRequester", fields: [requesterUserId], references: [id], onDelete: SetNull)

  @@index([expertUserId, status, createdAt])
  @@index([requesterUserId, createdAt])
  @@index([offerId, createdAt])
  @@map("consultation_requests")
}

/// HI-OS — onboarding import jobs (website / PDF)
model ImportJob {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String          @map("user_id") @db.Uuid
  type              ImportJobType
  status            ImportJobStatus @default(PENDING)
  sourceUrl         String?         @map("source_url")
  storagePath       String?         @map("storage_path")
  knowledgeSourceId String?         @map("knowledge_source_id") @db.Uuid
  errorMessage      String?         @map("error_message")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status])
  @@map("import_jobs")
}
