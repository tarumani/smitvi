# App
NEXT_PUBLIC_APP_URL=https://smitvi.com
NEXT_PUBLIC_APP_NAME=Smitvi
NODE_ENV=production

# Supabase Auth + Postgres
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Prefer pooled URL for DATABASE_URL on Vercel; DIRECT_URL for migrations if needed
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres?sslmode=require
DIRECT_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres?sslmode=require

# Storage: local (dev) | supabase (production default when NODE_ENV=production)
STORAGE_DRIVER=supabase
SUPABASE_STORAGE_BUCKET=knowledge

# Auth providers (Supabase Dashboard)
# Site URL: https://smitvi.com
# Redirect URLs: https://smitvi.com/auth/callback
#                 https://www.smitvi.com/auth/callback
#                 http://localhost:3000/auth/callback
# Site URL must be https://smitvi.com (or http://localhost:3000 locally) — never 0.0.0.0

# OpenAI
OPENAI_API_KEY=sk-...

# Stripe (live keys in production)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_BUSINESS=price_...

# Razorpay (live keys in production)
RAZORPAY_KEY_ID=rzp_live_...
RAZORPAY_KEY_SECRET=...
RAZORPAY_WEBHOOK_SECRET=...
RAZORPAY_PLAN_PRO=plan_...
RAZORPAY_PLAN_BUSINESS=plan_...

# Security
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60

# Comma-separated emails auto-promoted to ADMIN on first privileged visit
PLATFORM_ADMIN_EMAILS=you@example.com
# Comma-separated emails granted Business plan entitlements (testing/admin)
BUSINESS_TEST_EMAILS=
