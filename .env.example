# App
NEXT_PUBLIC_APP_URL=https://smitvi.com
NEXT_PUBLIC_APP_NAME=Smitvi
NODE_ENV=production

# Supabase Auth + Postgres
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Local dev (Docker — see README)
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/smitvi?sslmode=disable
# DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:5432/smitvi?sslmode=disable
#
# Prefer pooled URL for DATABASE_URL on Vercel; DIRECT_URL for migrations if needed
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres?sslmode=require
DIRECT_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres?sslmode=require

# Storage: local (dev) | supabase (production default when NODE_ENV=production)
STORAGE_DRIVER=supabase
SUPABASE_STORAGE_BUCKET=knowledge
SUPABASE_AVATARS_BUCKET=avatars

# Auth providers (Supabase Dashboard)
# Site URL: https://smitvi.com
# Redirect URLs:
#   https://smitvi.com/auth/callback
#   https://smitvi.com/auth/recovery/callback   (password reset)
#   http://localhost:3000/auth/callback
#   http://localhost:3000/auth/recovery/callback
# Password reset uses the same callback with next=/reset-password
# Site URL must be https://smitvi.com (or http://localhost:3000 locally) — never 0.0.0.0
#
# Google button on login/signup (off until custom domain is ready)
# Enable Google button on login/signup (inlined at Docker build)
NEXT_PUBLIC_ENABLE_GOOGLE_AUTH=true
#
# Branded verification email (Supabase → Authentication → SMTP, not app code):
# Sender name: Smitvi | From: noreply@smitvi.com (or support@smitvi.com via GoDaddy SMTP)
# See docs/AUTH_EMAIL_SMTP.md

# OpenAI
OPENAI_API_KEY=sk-...

# Billing: Razorpay-only for now (Safeyield live keys — set in Fly secrets, never commit)
BILLING_PROVIDER=RAZORPAY
RAZORPAY_KEY_ID=rzp_live_...
RAZORPAY_KEY_SECRET=...
# From Razorpay Dashboard → Webhooks (not a URL). Endpoint: https://smitvi.com/api/v1/billing/webhook/razorpay
RAZORPAY_WEBHOOK_SECRET=...
# Pro monthly / Business (create a Business plan or map yearly plan id)
RAZORPAY_PLAN_PRO=plan_...
RAZORPAY_PLAN_BUSINESS=plan_...
# Optional aliases (Safeyield-style names)
# RAZORPAY_PLAN_PRO_MONTHLY=plan_...
# RAZORPAY_PLAN_PRO_YEARLY=plan_...

# Stripe (optional; disabled when BILLING_PROVIDER=RAZORPAY)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=

# PayPal subscriptions (international) — client id is public; secret stays server-only
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=live
PAYPAL_PLAN_PRO=P-xxxxxxxx
PAYPAL_PLAN_BUSINESS=P-xxxxxxxx

# Security
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60

# Comma-separated emails auto-promoted to ADMIN on first privileged visit
PLATFORM_ADMIN_EMAILS=you@example.com
# Comma-separated emails granted Business plan entitlements (testing/admin)
BUSINESS_TEST_EMAILS=

# Cron (GitHub Actions + Fly must match)
CRON_SECRET=

# Google AdSense (loads only after cookie consent)
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-xxxxxxxx
# Optional display unit on marketing pages
NEXT_PUBLIC_ADSENSE_DISPLAY_SLOT=

# Optional: better Notion/website imports via Jina Reader
JINA_READER_API_KEY=
